<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.logisticsystem.controllers.RelatorioController"
            styleClass="root-pane"
            prefWidth="980" prefHeight="640">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets top="18" right="28" bottom="18" left="28"/>
            </padding>

            <Button text="←  Voltar" styleClass="back-button" onAction="#voltarMenu"/>

            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="RELATÓRIOS" styleClass="brand-title"/>
                <Label text="Módulo 05 — Estatísticas e análise de desempenho" styleClass="brand-subtitle"/>
            </VBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="horarioGeracaoLabel" text="" styleClass="next-horario"/>

            <Button fx:id="gerarRelatorioButton" text="↻  Gerar relatório" styleClass="action-button, action-amber, action-compact"
                    onAction="#gerarRelatorio"/>
        </HBox>
    </top>

    <center>
        <ScrollPane styleClass="right-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="16" styleClass="center-area">
                <padding>
                    <Insets top="16" right="20" bottom="20" left="20"/>
                </padding>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <VBox styleClass="panel, panel-amber" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="MOD. 01" styleClass="panel-code"/>
                        <Label text="Atendimentos" styleClass="panel-title"/>

                        <HBox spacing="20">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="atendimentosPendentesValor" text="0" styleClass="metric-value"/>
                                <Label text="Pendentes" styleClass="metric-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="tempoMedioEsperaValor" text="0 s" styleClass="metric-value-sm"/>
                                <Label text="Tempo médio de espera" styleClass="metric-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="panel, panel-teal" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="MOD. 02" styleClass="panel-code"/>
                        <Label text="Pedidos" styleClass="panel-title"/>

                        <HBox spacing="20">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="totalPedidosValor" text="0" styleClass="metric-value"/>
                                <Label text="Total cadastrados" styleClass="metric-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="pedidosAtivosValor" text="0" styleClass="metric-value-sm"/>
                                <Label text="Ativos" styleClass="metric-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="panel, panel-blue" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="MOD. 03" styleClass="panel-code"/>
                        <Label text="Entregas" styleClass="panel-title"/>

                        <HBox spacing="16">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="totalEntregasValor" text="0" styleClass="metric-value"/>
                                <Label text="Total" styleClass="metric-label"/>
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="entregasConcluidasValor" text="0" styleClass="metric-value"/>
                                <Label text="Concluídas" styleClass="metric-label"/>
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="entregasCanceladasValor" text="0" styleClass="metric-value"/>
                                <Label text="Canceladas" styleClass="metric-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="tempoMedioEntregaValor" text="0 h" styleClass="metric-value-sm"/>
                                <Label text="Tempo médio de entrega" styleClass="metric-label"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </GridPane>

                <VBox styleClass="panel, panel-coral" spacing="10">
                    <Label text="MOD. 04" styleClass="panel-code"/>
                    <Label text="Histórico" styleClass="panel-title"/>

                    <HBox spacing="20">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label fx:id="quantidadeMovimentacoesValor" text="0" styleClass="metric-value"/>
                            <Label text="Movimentações registradas" styleClass="metric-label"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="panel, panel-purple" spacing="14">
                    <Label text="ESTATÍSTICO" styleClass="panel-code"/>
                    <Label text="Relatório estatístico do sistema" styleClass="panel-title-lg"/>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>

                        <VBox styleClass="next-card, next-card-compact" spacing="4"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Tempo médio de processamento" styleClass="section-label"/>
                            <Label fx:id="tempoMedioProcessamentoValor" text="0 ms" styleClass="metric-value-sm"/>
                        </VBox>

                        <VBox styleClass="next-card, next-card-compact" spacing="4"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Estrutura mais eficiente" styleClass="section-label"/>
                            <Label fx:id="estruturaMaisEficienteValor" text="—" styleClass="metric-value-sm" wrapText="true"/>
                        </VBox>

                        <VBox styleClass="next-card, next-card-compact" spacing="4"
                              GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Algoritmo mais rápido" styleClass="section-label"/>
                            <Label fx:id="algoritmoMaisRapidoValor" text="—" styleClass="metric-value-sm"/>
                        </VBox>

                        <VBox styleClass="next-card, next-card-compact" spacing="4"
                              GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Quantidade de operações" styleClass="section-label"/>
                            <Label fx:id="quantidadeOperacoesValor" text="0" styleClass="metric-value-sm"/>
                        </VBox>

                        <VBox styleClass="next-card, next-card-compact" spacing="4"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Tamanho médio das filas" styleClass="section-label"/>
                            <Label fx:id="tamanhoMedioFilasValor" text="0" styleClass="metric-value-sm"/>
                        </VBox>

                        <VBox styleClass="next-card, next-card-compact" spacing="4"
                              GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label text="Taxa de crescimento" styleClass="section-label"/>
                            <Label fx:id="taxaCrescimentoValor" text="0 /dia" styleClass="metric-value-sm"/>
                        </VBox>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
