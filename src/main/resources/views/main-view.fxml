<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.logisticsystem.controllers.MainController"
            styleClass="root-pane"
            prefWidth="980" prefHeight="640">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets top="18" right="28" bottom="18" left="28"/>
            </padding>

            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="SISTEMA LOGÍSTICO EMERGENCIAL" styleClass="brand-title"/>
                <Label text="Central de operações" styleClass="brand-subtitle"/>
            </VBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <HBox styleClass="status-pill" alignment="CENTER" spacing="8">
                <Label text="●" styleClass="status-dot"/>
                <Label fx:id="statusLabel" text="OPERACIONAL" styleClass="status-text"/>
            </HBox>

            <Label fx:id="clockLabel" text="00:00:00" styleClass="clock-label"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" styleClass="center-area" spacing="28">
            <padding>
                <Insets top="20" right="40" bottom="40" left="40"/>
            </padding>

            <GridPane styleClass="module-grid" hgap="20" vgap="20" maxWidth="900">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="150"/>
                    <RowConstraints minHeight="150"/>
                </rowConstraints>

                <Button fx:id="btnAtendimento" styleClass="module-card, card-amber"
                        onAction="#abrirAtendimento"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"
                        maxWidth="Infinity" maxHeight="Infinity">
                    <graphic>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="MOD. 01" styleClass="card-code"/>
                            <Label text="Atendimentos" styleClass="card-title"/>
                            <Label text="Fila de prioridade emergencial" styleClass="card-desc" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnPedidos" styleClass="module-card, card-teal"
                        onAction="#abrirPedidos"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"
                        maxWidth="Infinity" maxHeight="Infinity">
                    <graphic>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="MOD. 02" styleClass="card-code"/>
                            <Label text="Pedidos" styleClass="card-title"/>
                            <Label text="Cadastro e controle de cargas" styleClass="card-desc" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnEntregas" styleClass="module-card, card-blue"
                        onAction="#abrirEntregas"
                        GridPane.columnIndex="2" GridPane.rowIndex="0"
                        maxWidth="Infinity" maxHeight="Infinity">
                    <graphic>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="MOD. 03" styleClass="card-code"/>
                            <Label text="Entregas" styleClass="card-title"/>
                            <Label text="Rotas e status de despacho" styleClass="card-desc" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnHistorico" styleClass="module-card, card-coral"
                        onAction="#abrirHistorico"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"
                        maxWidth="Infinity" maxHeight="Infinity">
                    <graphic>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="MOD. 04" styleClass="card-code"/>
                            <Label text="Histórico" styleClass="card-title"/>
                            <Label text="Movimentações e desfazer/refazer" styleClass="card-desc" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnRelatorios" styleClass="module-card, card-purple"
                        onAction="#abrirRelatorios"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"
                        maxWidth="Infinity" maxHeight="Infinity">
                    <graphic>
                        <VBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="MOD. 05" styleClass="card-code"/>
                            <Label text="Relatórios" styleClass="card-title"/>
                            <Label text="Estatísticas e análise de desempenho" styleClass="card-desc" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <VBox styleClass="info-card" alignment="CENTER" spacing="4"
                      GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <Label text="v1.0" styleClass="info-version"/>
                    <Label text="Estruturas implementadas manualmente" styleClass="info-text" wrapText="true" textAlignment="CENTER"/>
                </VBox>

            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="24">
            <padding>
                <Insets top="10" right="28" bottom="10" left="28"/>
            </padding>
            <Label text="Estrutura de Dados — Projeto Final" styleClass="footer-text"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Simael Da Silva Souza  ·  Arione Maia Gomes Filho" styleClass="footer-text"/>
        </HBox>
    </bottom>

</BorderPane>
